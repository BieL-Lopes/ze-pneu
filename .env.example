# Postgres (Supabase). Usar a connection string em modo "session", porta 5432.
DATABASE_URL=postgresql://postgres:senha@localhost:5432/zepneu

# Banco usado pelos testes de integração. Se ausente, os testes caem no
# DATABASE_URL acima — o que apaga dados, então em produção nunca deixe vazio.
DATABASE_URL_TEST=postgresql://postgres:senha@localhost:5432/zepneu_test

# URL pública do site, usada em metadata, sitemap e robots.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp comercial, só dígitos, com DDI e DDD. Ex: 5561999999999
NEXT_PUBLIC_WHATSAPP_NUMERO=5561999999999
