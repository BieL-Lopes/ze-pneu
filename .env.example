# Postgres (Supabase). Usar a connection string em modo "session", porta 5432.
DATABASE_URL=postgresql://postgres:senha@localhost:5432/zepneu

# Banco dos testes de integração. Opcional: sem ele, os testes usam o
# DATABASE_URL acima — o que é seguro, porque os testes criam registros
# marcados com um prefixo próprio e removem apenas esses. Nenhum dado real
# é tocado.
DATABASE_URL_TEST=

# URL pública do site, usada em metadata, sitemap e robots. OPCIONAL.
# Na Vercel, se ficar vazia ou ausente, o site usa sozinho o domínio de
# produção do projeto (e a URL do próprio deploy em preview). Só preencha
# para forçar um endereço diferente. Ver src/lib/site-url.ts.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp comercial, só dígitos, com DDI e DDD. Ex: 5561999999999
NEXT_PUBLIC_WHATSAPP_NUMERO=5561999999999
