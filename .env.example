# Postgres (Supabase). Usar a connection string em modo "session", porta 5432.
DATABASE_URL=postgresql://postgres:senha@localhost:5432/zepneu

# Banco dos testes de integração. Opcional: sem ele, os testes usam o
# DATABASE_URL acima — o que é seguro, porque os testes criam registros
# marcados com um prefixo próprio e removem apenas esses. Nenhum dado real
# é tocado.
DATABASE_URL_TEST=

# URL pública do site, usada em metadata, sitemap e robots. OPCIONAL.
# Na Vercel, se ficar vazia ou ausente, o site usa sozinho o domínio de
# produção do projeto (e a URL do próprio deploy em preview). Só preencha
# para forçar um endereço diferente. Ver src/lib/site-url.ts.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp comercial, só dígitos, com DDI e DDD. Ex: 5561999999999
NEXT_PUBLIC_WHATSAPP_NUMERO=5561999999999

# --- Checkout -----------------------------------------------------------------
# Sem estas variáveis a loja continua no ar: sem Mercado Pago o checkout mostra
# "pagamento indisponível" e aponta para o WhatsApp; sem Melhor Envio só a
# retirada em Brasília aparece.

# Mercado Pago > Suas integrações > Credenciais. Em desenvolvimento use a de
# TESTE; a de produção vai só nas variáveis da Vercel.
MERCADO_PAGO_ACCESS_TOKEN=
# Mercado Pago > Suas integrações > Webhooks > "Assinatura secreta". Sem ela o
# aviso de pagamento é recusado — não há como saber se veio do Mercado Pago.
MERCADO_PAGO_WEBHOOK_SECRET=

# Melhor Envio > Integrações > Permissões de acesso > Gerar token.
MELHOR_ENVIO_TOKEN=
# sandbox ou producao. O token do sandbox só funciona no sandbox, e vice-versa.
MELHOR_ENVIO_AMBIENTE=sandbox
# CEP de onde o pneu sai (a loja em Brasília).
MELHOR_ENVIO_CEP_ORIGEM=
# Contato técnico. A API do Melhor Envio exige um e-mail no User-Agent.
MELHOR_ENVIO_EMAIL=

# Protege a rotina que cancela pedidos não pagos. A Vercel envia este valor
# sozinha no agendamento. Gere com: openssl rand -hex 32
CRON_SECRET=
